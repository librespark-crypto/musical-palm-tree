# ---------------------------------------------------------------------------
# JEE Command Center - environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and set the same
# variables in the Vercel project settings for a deployment.
#
# The AI coach is OPTIONAL. Without GEMINI_API_KEY the app runs fully offline
# and the coach falls back to deterministic, data-driven rule-based
# recommendations. No secret is ever shipped to the browser: the key is only
# read by the server-side route handler at /api/ai/*.
# ---------------------------------------------------------------------------

# Google AI Studio key used by the server-side AI route (never exposed to the client).
GEMINI_API_KEY=

# Optional: force a specific Gemini model. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional: disable the AI routes entirely (they will answer 503 and the client
# will use the rule-based coach).
AI_ENABLED=true
